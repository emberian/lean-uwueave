#!/usr/bin/env bash
set -euo pipefail

tool_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_dir=$(dirname -- "$tool_dir")
cd "$repo_dir"
# ArtifactEmit supplies a proved-equal tail-safe framing implementation so the
# ordinary Lean interpreter can execute large canonical artifacts directly.
# Build the audited Main module first, then run it through an import-only stdin
# root.  Elaborating Main directly prints its trust-floor audit diagnostic to
# stdout, which would corrupt the command's binary `--stdout` contract.
lake build Uwueave.Preo.ArtifactEmitMain >/dev/null
printf '%s\n' 'import Uwueave.Preo.ArtifactEmitMain' |
  lake env lean --stdin --run /dev/stdin "$@"
